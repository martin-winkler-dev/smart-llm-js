{
  "name": "smart-llm-monorepo",
  "description": "One request form for Gemini, DeepSeek, Groq and Ollama, with named models, capabilities and smart-limit limits",
  "author": "Martin Winkler",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martin-winkler-dev/smart-llm-js.git"
  },
  "bugs": {
    "url": "https://github.com/martin-winkler-dev/smart-llm-js/issues"
  },
  "homepage": "https://github.com/martin-winkler-dev/smart-llm-js#readme",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "clean": "tsc -b --clean && bun run --filter \"@smart-llm/*\" clean",
    "build": "bun run clean && bun run build:types && bun run build:js",
    "build:types": "tsc -b",
    "build:js": "bun run --filter \"@smart-llm/*\" build:js",
    "test": "bun run build && bun test --only-failures && bun run test:types",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:live:ollama": "bun test --timeout 120000 ./packages/ollama/tests/live/embed.live.ts",
    "test:live:gemini": "bun test --timeout 60000 --env-file ../smart-genai/.env ./packages/gemini/tests/live/embed.live.ts",
    "test:dist": "bun run --filter \"@smart-llm/*\" test:dist",
    "test:package": "bun run --filter \"@smart-llm/*\" test:package",
    "coverage": "bun test --coverage",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci --error-on-warnings .",
    "check": "bun run lint:ci && bun run build && bun run test:types && bun test --only-failures && bun run test:dist && bun run test:package"
  },
  "devDependencies": {
    "@smart-llm/core": "workspace:*",
    "@smart-llm/deepseek": "workspace:*",
    "@smart-llm/gemini": "workspace:*",
    "@smart-llm/groq": "workspace:*",
    "@smart-llm/ollama": "workspace:*",
    "@smart-llm/openai-compatible": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.12.0",
    "bun-test-runner": "latest",
    "smartin": "latest",
    "typescript": "^7.0.2"
  }
}
