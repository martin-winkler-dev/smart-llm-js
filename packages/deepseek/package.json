{
  "name": "@smart-llm/deepseek",
  "version": "0.1.0",
  "description": "smart-llm provider adapter for the DeepSeek API",
  "keywords": [],
  "author": "Martin Winkler",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martin-winkler-dev/smart-llm-js.git",
    "directory": "packages/deepseek"
  },
  "bugs": {
    "url": "https://github.com/martin-winkler-dev/smart-llm-js/issues"
  },
  "homepage": "https://github.com/martin-winkler-dev/smart-llm-js#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "bun run clean && bun run build:types && bun run build:js",
    "build:types": "tsc -b",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external --sourcemap=linked --banner=\"/*! Copyright 2026 Martin Winkler. SPDX-License-Identifier: Apache-2.0 */\"",
    "test": "bun test --only-failures",
    "test:dist": "node tests/smoke/smoke.mjs && node tests/smoke/smoke.cjs",
    "test:package": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@smart-llm/core": "workspace:^",
    "@smart-llm/openai-compatible": "workspace:^"
  }
}
